# Database
DATABASE_URL=postgresql://qatrial:qatrial@localhost:5432/qatrial

# Authentication — required, min 32 chars of entropy
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-openssl-rand-hex-48-at-least-32-chars

# AI Provider (optional)
AI_PROVIDER_TYPE=anthropic
AI_PROVIDER_URL=https://api.anthropic.com
AI_PROVIDER_KEY=sk-ant-your-key-here
AI_PROVIDER_MODEL=claude-sonnet-4-20250514

# SSO (optional) — GSMS Core as OpenID Connect provider, see
# docs/architecture/IDENTITE-SSO.md (monorepo root). Works with any OIDC IdP.
# SSO_ENABLED=true
# SSO_TYPE=oidc
# SSO_ISSUER_URL=https://gsms-security.com
# SSO_CLIENT_ID=qatrial
# SSO_CLIENT_SECRET=your-client-secret
# SSO_CALLBACK_URL=http://localhost:3001/api/auth/sso/callback
# SSO_ROLE_CLAIM=gsms_role        # claim with the QAtrial role; synced on every login
# SSO_ORG_NAME=GSMS               # all SSO users join this organisation (created if absent)
# SSO_PROVIDER_NAME=GSMS          # button label: "Se connecter avec GSMS"
# SSO_DEFAULT_ROLE=qa_engineer    # only for new users when the IdP sends no role claim
# SSO_AUTO_PROVISION=true

# Self-service sign-up (POST /api/auth/register). Set to false when accounts come from SSO.
# REGISTRATION_ENABLED=true

# Dev-only login prefill (Vite DEV). Prefer `.env.local` — not for production.
# VITE_DEV_LOGIN_EMAIL=you@example.com
# VITE_DEV_LOGIN_PASSWORD=your-local-password
