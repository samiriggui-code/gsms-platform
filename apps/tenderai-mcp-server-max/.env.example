# MCP Appel d'offres (GSMS) — configuration. Copier en .env ; ne jamais committer .env.

# Transport : "stdio" en local, "http" pour le Core GSMS et le VPS
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# Authentification — OBLIGATOIRE en http : sans MCP_API_KEY ni OAUTH_ISSUER_URL, le serveur refuse de démarrer.
# MCP_API_KEY = même valeur que GSMS_TENDERAI_MCP_TOKEN dans le .env de la plateforme (openssl rand -hex 32).
MCP_API_KEY=

# OAuth 2.0 (connecteur claude.ai) : URL publique HTTPS du serveur. Prioritaire sur MCP_API_KEY.
OAUTH_ISSUER_URL=

# Anthropic
ANTHROPIC_API_KEY=
# Modèle Claude (identifiant exact). Vide = claude-opus-5-5.
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=4096

# Voyage AI (facultatif — recherche vectorielle dans les réponses passées)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-lite
EMBEDDING_DIMENSIONS=512

# Base
DATABASE_PATH=db/tenderai.db

# Données
DATA_DIR=data

# Plafond d'un fichier échangé en base64 avec le Core (Mo)
MAX_FILE_MB=20

# Société (page de garde, pied de page)
COMPANY_NAME=GSMS
DEFAULT_CURRENCY=EUR
DEFAULT_MARGIN_PCT=15

# Journal
LOG_LEVEL=INFO
