# URL publique de apps/web (navigateur). Évite les redirects vers 0.0.0.0
# quand Next écoute sur toutes les interfaces.
# APP_URL=http://localhost:3000

# URL interne du Core GSMS (FastAPI). Jamais exposée au navigateur :
# seuls les Server Components et route handlers de apps/web l'utilisent.
CORE_API_URL=http://localhost:8000

# Délai max (ms) d'un appel au Core avant de considérer le Core indisponible.
CORE_TIMEOUT_MS=5000

# Nom du cookie de session (JWT Core, httpOnly). Laisser la valeur par défaut.
# SESSION_COOKIE_NAME=gsms_session
