# GSMS Core — copier en .env et adapter. Aucune valeur ci-dessous n'est un vrai secret.
GSMS_ENV=dev
GSMS_DATABASE_URL=sqlite:///./var/gsms_core.db
# Production : postgresql+psycopg://gsms:***@localhost:5432/gsms_core
GSMS_JWT_SECRET=change-me-dev-only-not-a-secret-0123456789
GSMS_JWT_TTL_MINUTES=60

# Stockage objet : local | s3
GSMS_STORAGE_BACKEND=local
GSMS_STORAGE_LOCAL_ROOT=./var/blobs
GSMS_S3_ENDPOINT_URL=http://localhost:9000
GSMS_S3_BUCKET=gsms-documents
GSMS_S3_ACCESS_KEY=minioadmin
GSMS_S3_SECRET_KEY=minioadmin
GSMS_S3_REGION=us-east-1
GSMS_MAX_UPLOAD_MB=100

# Secrets HMAC des webhooks entrants, par source (JSON)
GSMS_WEBHOOK_SECRETS={"grace":"dev-grace-secret","qatrial":"dev-qatrial-secret","crm":"dev-crm-secret"}

# Connecteurs (anti-corruption)
GSMS_CRM_URL=http://localhost:3001
GSMS_CRM_TOKEN=
GSMS_GRACE_URL=http://localhost:3002
GSMS_GRACE_TOKEN=
GSMS_QATRIAL_URL=http://localhost:3003
GSMS_QATRIAL_TOKEN=

# Passerelle MCP (streamable-http, Bearer)
GSMS_TENDERAI_MCP_URL=http://localhost:8765/mcp
GSMS_TENDERAI_MCP_TOKEN=
GSMS_LEXSOCKET_MCP_URL=https://mcp.lexsocket.ai/
GSMS_LEXSOCKET_MCP_TOKEN=

# Workflows
GSMS_REMEDIATION_SEVERITY_THRESHOLD=minor

# Seed de démo (mot de passe commun des comptes de démonstration)
GSMS_SEED_PASSWORD=demo-password-change-me
