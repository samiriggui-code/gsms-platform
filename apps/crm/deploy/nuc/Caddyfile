}

# ── MinIO — console UI (S3 API reste minio:9000 pour le CRM) ────────────────
minio.global-it-ss.com {
	encode gzip zstd
	handle /minio/health/live {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy minio:9001
	}
}

# ── Admin / monitoring homepage ─────────────────────────────────────────────
# index.html is a public static shell with no secrets; only status.json (the
# real data + creds) sits behind basic_auth. The page's own login dialog
# supplies the Authorization header — see admin/index.html.
admin.global-it-ss.com {
	encode gzip zstd

	@data path /status.json
	basic_auth @data {
		admin@global-it-ss.com $2a$14$cm1pc4cnd5RRmvk50ofr4uloTyUYiybvQtbVyO4N50G22tLVKfGNa
	}

	root * /srv/admin
	file_server
}
