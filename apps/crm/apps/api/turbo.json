{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$", "trpc:generate"]
		},
		"trpc:generate": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.ts"],
			"outputs": ["src/generated/**"]
		},
		"dev": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"AUTH_COOKIE_DOMAIN",
				"AUTH_TRUSTED_ORIGINS",
				"BLOB_READ_WRITE_TOKEN",
				"S3_ENDPOINT",
				"S3_BUCKET",
				"S3_ACCESS_KEY_ID",
				"S3_SECRET_ACCESS_KEY",
				"S3_PUBLIC_URL",
				"NEXTAUTH_SECRET",
				"CACHE_TTL_MS",
				"DATABASE_URL",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"MICROSOFT_CLIENT_ID",
				"MICROSOFT_CLIENT_SECRET",
				"MICROSOFT_TENANT_ID",
				"PORT",
				"REDIS_URL",
				"GSMS_PUBLIC_API_KEY",
				"GRACE_API_URL",
				"GRACE_API_TOKEN",
				"QATRIAL_API_URL",
				"QATRIAL_API_TOKEN"
			]
		},
		"test": {
			"passThroughEnv": [
				"AUTH_COOKIE_DOMAIN",
				"AUTH_TRUSTED_ORIGINS",
				"BLOB_READ_WRITE_TOKEN",
				"S3_ENDPOINT",
				"S3_BUCKET",
				"S3_ACCESS_KEY_ID",
				"S3_SECRET_ACCESS_KEY",
				"S3_PUBLIC_URL",
				"NEXTAUTH_SECRET",
				"CACHE_TTL_MS",
				"DATABASE_URL",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"MICROSOFT_CLIENT_ID",
				"MICROSOFT_CLIENT_SECRET",
				"MICROSOFT_TENANT_ID",
				"PORT",
				"REDIS_URL"
			]
		}
	}
}
