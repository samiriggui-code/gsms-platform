# GSMS Documents — production (doculens.gsms-security.com)
DATABASE_NAME=doculens
DATABASE_USER=doculens
DATABASE_PASSWORD=change-me-strong

DOCULENS_AUTH_SECRET=change-me-local-jwt-secret-min-32-chars
DOCULENS_API_KEY=change-me-service-api-key
DOCULENS_API_KEY_HEADER=X-API-Key
DOCULENS_CORS_ORIGINS=["https://doculens.gsms-security.com","https://gsms-security.com"]
DOCULENS_LOG_LEVEL=INFO

# Même secret JWT que le Core (iss=gsms-core)
GSMS_PLATFORM_JWT_SECRET=change-me-same-as-core-jwt-secret
# URL interne ou publique du Core
GSMS_CORE_URL=https://gsms-security.com
# Secret HMAC webhook_secrets.doculens du Core
GSMS_CORE_WEBHOOK_SECRET=change-me-hmac-doculens
GSMS_CORE_TIMEOUT_SECONDS=10

# LLM — plusieurs clés possibles ; DOCULENS_LLM_PROVIDER choisit (auto|openrouter|anthropic|openai|llama)
# Alias : codex/gpt → openai, claude → anthropic. OPENROUTER_API_KEY ou OPEN_ROUTER_API_KEY.
DOCULENS_LLM_PROVIDER=auto
# DOCULENS_LLM_MODEL=anthropic/claude-3.5-sonnet
DOCULENS_EMBEDDING_PROVIDER=auto
# DOCULENS_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPEN_ROUTER_API_KEY=   # alias historique, aussi accepté

# Traefik
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERTRESOLVER=letsencrypt
