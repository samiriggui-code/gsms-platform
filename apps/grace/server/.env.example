# Postgres connection string
DATABASE_URL="postgresql://csmp:csmp@localhost:5432/csmp_v2?schema=public"

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET="replace-me-with-a-real-secret-at-least-32-chars-long-do-it-now"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS — comma-separated list of allowed origins for browser clients
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"

# ── « Se connecter avec GSMS » (OpenID Connect, GSMS Core) ───────────────────
# See docs/architecture/IDENTITE-SSO.md at the platform root. When SSO_ENABLED
# is "true", the API refuses to start unless the four variables below are set.
SSO_ENABLED=false
SSO_ISSUER_URL="https://gsms-security.com"
SSO_CLIENT_ID="grace"
# Secret shown once by: docker compose exec core python -m gsms_core.cli sso-client grace --redirect-uri <SSO_CALLBACK_URL>
SSO_CLIENT_SECRET=""
# Must match the redirect URI registered in the Core exactly. Local dev via Vite:
SSO_CALLBACK_URL="http://localhost:5173/api/auth/sso/callback"
# id_token claim carrying the GRACE role (ADMIN|LEAD_ASSESSOR|ASSESSOR|REVIEWER|STAKEHOLDER)
SSO_ROLE_CLAIM="gsms_role"
# Label of the login button: "Se connecter avec <SSO_PROVIDER_NAME>"
SSO_PROVIDER_NAME="GSMS"
