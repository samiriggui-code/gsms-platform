# Copy to .env and replace ALL secrets before running `docker compose up`.

# Postgres
POSTGRES_USER=csmp
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=csmp_v2

# API
DATABASE_URL=postgresql://csmp:change-me-in-production@postgres:5432/csmp_v2?schema=public
JWT_SECRET=generate-with-openssl-rand-hex-32-minimum-32-chars-long
JWT_EXPIRES_IN=7d

# Web
WEB_HOST_PORT=8080
API_HOST_PORT=3001

# « Se connecter avec GSMS » (OpenID Connect) — see server/.env.example
SSO_ENABLED=false
SSO_ISSUER_URL=https://gsms-security.com
SSO_CLIENT_ID=grace
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=http://localhost:8080/api/auth/sso/callback
SSO_ROLE_CLAIM=gsms_role
SSO_PROVIDER_NAME=GSMS
